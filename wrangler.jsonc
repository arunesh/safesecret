{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safesecret",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (the built React app). `run_worker_first` is essential: with
  // single-page-application not_found_handling, the asset router would otherwise
  // answer /api/* with index.html and the Worker would never see the request.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safesecret",
      // Placeholder: local dev works as-is. Before the first deploy run
      //   npx wrangler d1 create safesecret
      // and paste the returned id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly sweep of expired rows. Expiry is enforced on read regardless, so this
  // is hygiene rather than correctness.
  "triggers": { "crons": ["0 * * * *"] },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
